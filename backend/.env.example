# ============================================================
# Database — Supabase Postgres
# ============================================================
# Ambil dari Supabase Dashboard > Project Settings > Database > Connection string
#
# 1) Untuk pengembangan lokal / proses long-lived (mis. `uvicorn --reload`):
#    pakai "Session pooler" (port 5432) atau koneksi Direct.
# 2) Untuk deployment serverless (Vercel), WAJIB pakai "Transaction pooler"
#    (port 6543, host berakhiran pooler.supabase.com) — tiap invocation function
#    membuka koneksi baru, dan pgbouncer di sisi Supabase yang menanganinya.
#
# Format:
# postgresql+psycopg2://postgres.<project-ref>:<password>@<host>:<port>/postgres
DATABASE_URL=postgresql+psycopg2://postgres.xxxxxxxxxxxx:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ============================================================
# CORS — daftar origin frontend yang diizinkan (pisahkan dengan koma)
# ============================================================
# Dev lokal:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Produksi (contoh setelah deploy frontend di Vercel):
# CORS_ORIGINS=https://meta-vrp.vercel.app
CORS_ORIGINS=*
