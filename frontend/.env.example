# Kosongkan (atau hapus baris ini) untuk dev lokal — Vite proxy '/api' di
# vite.config.ts akan meneruskan ke backend lokal.
#
# Isi dengan URL backend produksi ketika frontend & backend di-deploy terpisah
# (mis. dua project Vercel), tanpa trailing slash:
# VITE_API_BASE_URL=https://meta-vrp-backend.vercel.app
VITE_API_BASE_URL=
